<Window x:Class="PeHunter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PeHunter.ViewModels"
        Title="PeHunter" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgPrimaryBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: TITLE BAR -->
        <Border Grid.Row="0" Background="#181818" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Border Background="#00FF41" Width="22" Height="22" Margin="0,0,8,0">
                            <TextBlock Text="PH" Foreground="#121212" FontWeight="Bold" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="PeHunter" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="— PE STATIC ANALYZER" Foreground="#666666" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="● OFFLINE / v1.0.4" Foreground="#00FF41" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="–" Click="Minimize_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                    <Button Content="□" Click="Maximize_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                    <Button Content="✕" Click="Close_Click" Style="{StaticResource TitleCloseButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: TOP BAR -->
        <Border Grid.Row="1" Background="#121212" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Open File" Command="{Binding OpenFileCommand}" Style="{StaticResource TopBarButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Analyze" Command="{Binding AnalyzeFileCommand}" Style="{StaticResource AnalyzeButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Export Report" Command="{Binding ExportReportCommand}" Style="{StaticResource TopBarButtonStyle}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="● OFFLINE / v1.0.4" Foreground="#00FF41" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0"/>
            </Grid>
        </Border>

        <!-- ROW 2: FILE INFO BAR -->
        <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12">
                    <Run Text="File: " Foreground="#AAAAAA"/>
                    <Run Text="{Binding CurrentFileData.FileName, FallbackValue=none, Mode=OneWay}" Foreground="White"/>
                    <Run Text=" | Arch: " Foreground="#AAAAAA"/>
                    <Run Text="{Binding CurrentFileData.Architecture, FallbackValue=-, Mode=OneWay}" Foreground="White"/>
                    <Run Text=" | Type: " Foreground="#AAAAAA"/>
                    <Run Text="{Binding CurrentFileData.FileType, FallbackValue=-, Mode=OneWay}" Foreground="White"/>
                    <Run Text=" | EP: " Foreground="#AAAAAA"/>
                    <Run Text="{Binding CurrentFileData.EntryPoint, StringFormat=0x{0:X8}, FallbackValue=-, Mode=OneWay}" Foreground="White"/>
                </TextBlock>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                           Text="{Binding IsAnalyzing, Converter={StaticResource BoolToAnalysisStatusConverter}}"
                           Foreground="{Binding IsAnalyzing, Converter={StaticResource BoolToAnalysisStatusColorConverter}}"/>
            </Grid>
        </Border>

        <!-- ROW 3: TABS -->
        <Border Grid.Row="3" Background="#121212" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="General" Command="{Binding SwitchTabCommand}" CommandParameter="0"
                        Background="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBackgroundConverter}, ConverterParameter=0}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToForegroundConverter}, ConverterParameter=0}"
                        Style="{StaticResource TabButtonStyle}"/>
                <Button Content="Sections" Command="{Binding SwitchTabCommand}" CommandParameter="1"
                        Background="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBackgroundConverter}, ConverterParameter=1}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToForegroundConverter}, ConverterParameter=1}"
                        Style="{StaticResource TabButtonStyle}"/>
                <Button Content="Imports" Command="{Binding SwitchTabCommand}" CommandParameter="2"
                        Background="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBackgroundConverter}, ConverterParameter=2}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToForegroundConverter}, ConverterParameter=2}"
                        Style="{StaticResource TabButtonStyle}"/>
                <Button Content="Anomalies" Command="{Binding SwitchTabCommand}" CommandParameter="3"
                        Background="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBackgroundConverter}, ConverterParameter=3}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToForegroundConverter}, ConverterParameter=3}"
                        Style="{StaticResource TabButtonStyle}"/>
                <Button Content="Report" Command="{Binding SwitchTabCommand}" CommandParameter="4"
                        Background="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBackgroundConverter}, ConverterParameter=4}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToForegroundConverter}, ConverterParameter=4}"
                        Style="{StaticResource TabButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- ROW 4: CONTENT -->
        <ContentControl Grid.Row="4" Content="{Binding CurrentView}"/>

        <!-- ROW 5: STATUS BAR -->
        <Border Grid.Row="5" Background="#1E1E1E" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#00FF41" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="STATIC ONLY  |  NO CODE EXECUTED  |  LOCAL SESSION" Foreground="#666666" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>