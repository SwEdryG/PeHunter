<UserControl x:Class="PeHunter.Views.FileBrowserSaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="&gt;_" Foreground="#00FF41" FontSize="18" FontWeight="Bold" Margin="0,0,8,0"/>
                <TextBlock Text="Save File" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,8,0"/>
                <TextBlock Text="/ Select a destination to save the PE report" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="PE32 / PE32+ / LOCAL FILE SYSTEM" Foreground="#666666" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
        </Grid>

        <Grid Grid.Row="1" Background="#1E1E1E" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Save in:" Foreground="#AAAAAA" FontSize="11" Margin="10,0,8,0" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding BrowserPath, UpdateSourceTrigger=PropertyChanged}"
                     Background="#121212" Foreground="White" BorderBrush="#333333" BorderThickness="1"
                     Padding="8,6" Margin="0,6,6,6" FontSize="11"/>
            <Button Grid.Column="2" Content="➜" Command="{Binding BrowserGoCommand}" Width="30" Margin="0,6,4,6" Background="#252526" Foreground="#00FF41" BorderBrush="#333333"/>
            <Button Grid.Column="3" Content="↑" Command="{Binding BrowserGoUpCommand}" Width="30" Margin="0,6,4,6" Background="#252526" Foreground="White" BorderBrush="#333333"/>
            <Button Grid.Column="4" Content="⟳" Command="{Binding BrowserRefreshCommand}" Width="30" Margin="0,6,6,6" Background="#252526" Foreground="White" BorderBrush="#333333"/>
            <Border Grid.Column="5" Background="#121212" BorderBrush="#333333" BorderThickness="1" Padding="8,6" Margin="0,6,10,6">
                <TextBlock Text="🔍 Search folder" Foreground="#666666" FontSize="11"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E1E1E" Padding="10" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Locations" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Locations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Command="{Binding DataContext.BrowserSelectLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Path}"
                                        Background="Transparent" Foreground="White" BorderThickness="0"
                                        HorizontalContentAlignment="Left" Padding="8,6" FontSize="12" Cursor="Hand"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="LOCAL ACCESS ONLY" Foreground="#00FF41" FontSize="10" Margin="8,12,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#252526">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="10,7"/>
                    <TextBlock Grid.Column="1" Text="Date modified" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="10,7"/>
                    <TextBlock Grid.Column="2" Text="Type" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="10,7"/>
                    <TextBlock Grid.Column="3" Text="Size" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="10,7"/>
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding BrowserEntries}" SelectedItem="{Binding BrowserSelected}"
                         Background="#1E1E1E" BorderThickness="1" BorderBrush="#333333"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1F3D1F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Foreground="#FFCC00" FontSize="12" Margin="10,0,6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="📄"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="Text" Value="📁"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DateModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="#AAAAAA" FontSize="11" Margin="10,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="#AAAAAA" FontSize="11" Margin="10,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="#AAAAAA" FontSize="11" Margin="10,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Background="#1E1E1E" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding BrowserCounts}" Foreground="#AAAAAA" FontSize="10" Margin="10,6"/>
            <TextBlock Grid.Column="1" Text="Choose a location, then click Save." Foreground="#666666" FontSize="10" Margin="0,6,10,6"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="File name:" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SaveFileName, UpdateSourceTrigger=PropertyChanged}"
                             Background="#121212" Foreground="White" BorderBrush="#00FF41" BorderThickness="1" Padding="8,6" FontSize="12"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Files of type:" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SaveFileTypes}" SelectedIndex="{Binding SaveFileTypeIndex}"
                                Style="{StaticResource DarkComboBoxStyle}"/>
                </Grid>
                <TextBlock Text="Reports are written locally. The analyzed binary is not modified." Foreground="#666666" FontSize="10" Margin="90,6,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Save" Command="{Binding BrowserConfirmSaveCommand}"
                    Background="#00FF41" Foreground="#121212" FontWeight="Bold" Padding="25,10" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"/>
            <Button Grid.Column="2" Content="Cancel" Command="{Binding BrowserCancelSaveCommand}"
                    Background="#252526" Foreground="White" Padding="25,10" BorderBrush="#444444" Cursor="Hand"/>
        </Grid>
    </Grid>
</UserControl>